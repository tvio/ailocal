# Vzor nastavení pro server. Zkopírovat jako .env (je v .gitignore) a upravit.
# uv ho načte samo, když je v prostředí UV_ENV_FILE=.env (viz
# docs/provoz_prenos_na_server.md), nebo ručně: uv run --env-file .env …
# Co tu není, bere se z common/config.py.

# Stroje s Ollamou v pořadí priority (název=adresa, oddělené čárkou)
OLLAMA_UZLY=spark=http://10.6.38.10:11434,dell=http://10.6.38.9:11434
# Kolik dotazů naráz na jeden stroj, než se sáhne na další
OLLAMA_SOUBEZNE=1
# Kolik sekund smí hledání čekat na router a na vektor dotazu
HLEDANI_TIMEOUT_S=30

# Docling Serve (převod PDF) – na notebooku tunel na localhost:5001
DOCLING_SERVE_URL=http://10.6.38.10:5001

# PostgreSQL (výchozí = kontejner z docker-compose.yml na tomtéž stroji)
PG_HOST=localhost
PG_PORT=5432
PG_USER=localsemantic
PG_PASSWORD=localsemantic
PG_DATABASE=localsemantic

# Kam Postgres v kontejneru ukládá data. Nezadáno = volume Dockeru
# (/var/lib/docker). Na serveru je tam málo místa, proto adresář na /opt.
# Čte to docker compose (ne aplikace); po změně: docker compose up -d
#PGDATA_DIR=./data/pgdata

# HTTPS pro GUI (kontejner nginx, jen na serveru). Profil "server" ho zapne.
# Certifikát se čte přímo z adresáře, kde ho správci obnovují; po výměně:
# docker exec localsemantic-nginx nginx -s reload
#COMPOSE_PROFILES=server
#GUI_PORT=8090
#TLS_CERT_DIR=/opt/nginx/cert
#TLS_CERT=sukl.cz.crt
#TLS_KEY=sukl.cz.key
## Kde nginx najde API: unixový socket uvicornu (run/api.sock, žádný síťový port).
## Až bude API v kontejneru: jméno služby a port, např. api:8000
#API_UPSTREAM=unix:/run/localsemantic/api.sock:
